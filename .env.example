# Google Drive Folder IDs
GOOGLE_DRIVE_VIDEO_FOLDER_ID=your_video_folder_id_here
GOOGLE_DRIVE_AUDIO_FOLDER_ID=your_audio_folder_id_here
GOOGLE_DRIVE_IMAGE_FOLDER_ID=your_image_folder_id_here

# Google Service Account Authentication
GOOGLE_SERVICE_ACCOUNT_KEY=service_account.json

# Local Directories Fallback
LOCAL_VIDEO_DIR=input_videos
LOCAL_AUDIO_DIR=input_audio
LOCAL_IMAGE_DIR=input_images

# Automation Settings
CHANNEL_NAME=Calm Relaxation
DEFAULT_DURATION=3600
ALLOW_REPOST=true
